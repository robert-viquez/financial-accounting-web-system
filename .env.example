# Replace all CHANGE_ME values before exposing FAWS publicly.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
# Add the server hostname or IP address used to reach FAWS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_X_FORWARDED_PROTO=true
# Same-origin requests through the frontend proxy need no CORS origin. Add only
# explicit trusted origins when serving the frontend and API separately.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the public HTTPS origin (for example https://faws.example.com) when used.
CSRF_TRUSTED_ORIGINS=

MYSQL_DATABASE=faws
MYSQL_USER=faws
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_different_root_password

VITE_API_URL=/api/
VITE_DEMO_MODE=false
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=

# Bind to 127.0.0.1 when a separate reverse proxy is the only public entry point.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173

# Portfolio-demo features are opt-in. Normal installations must keep these off.
ALLOW_DEMO_SEED=false
DEMO_USERNAME=
DEMO_PASSWORD=
