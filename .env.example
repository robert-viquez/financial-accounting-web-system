DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_DATABASE=queso_los_santos
MYSQL_USER=accounting_app
MYSQL_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
DJANGO_USE_SQLITE_TESTS=true

VITE_API_URL=http://127.0.0.1:8000/api/
