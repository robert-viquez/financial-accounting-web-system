# All settings are optional for the standalone image. The default SQLite
# database and generated secret live in /data.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_X_FORWARDED_PROTO=true
# Same-origin requests through the frontend proxy need no CORS origin. Add only
# explicit trusted origins when serving the frontend and API separately.
CORS_ALLOWED_ORIGINS=
# Add the public HTTPS origin (for example https://faws.example.com) when used.
CSRF_TRUSTED_ORIGINS=

# Default standalone database.
DATABASE_ENGINE=sqlite
SQLITE_PATH=/data/faws.sqlite3
FAWS_DATA_DIR=/data

# Optional external MySQL deployment: set DATABASE_ENGINE=mysql.
MYSQL_DATABASE=faws
MYSQL_USER=faws
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_HOST=db
MYSQL_PORT=3306

VITE_API_URL=/api/
VITE_DEMO_MODE=false
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=

# Runtime tuning. SQLite intentionally defaults to one Gunicorn worker.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
